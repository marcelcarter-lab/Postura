# Flask configuration
FLASK_APP=app
FLASK_ENV=development

# SECRET_KEY is used to sign session cookies and CSRF tokens. The
# default below is safe for local development ONLY. In any deployed
# environment, this MUST be replaced with a long, random, unique
# value (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
SECRET_KEY=changeme

# PostgreSQL connection string. The default below matches the
# docker-compose.yml db service's credentials for local development.
DATABASE_URL=postgresql://postura_user:postura_pass@db:5432/postura_db

# Controls whether this process runs the background scheduler for
# recurring scans. Should be "true" on exactly one running instance.
# If you run multiple app workers/replicas, set this to "false" on
# all but one. A database-level advisory lock provides an automatic
# fallback even if this is misconfigured, but explicit configuration
# is the primary, intended control.
SCHEDULER_ENABLED=true

# How often (in seconds) the scheduler checks for due websites and
# runs scheduled scans. Defaults to 300 (5 minutes) for normal
# operation. For dev-mode testing/verification, set this lower (e.g.
# 60) to see scheduled scans fire quickly without a long wait.
SCHEDULER_INTERVAL_SECONDS=300

# Email (Sprint 10). Defaults below work with a local Mailhog instance
# for development (see docker-compose.yml). For a real deployment,
# override these with real SMTP provider credentials.
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@postura.local

# The public URL this app is reachable at — used to build absolute
# links in emails (e.g. "view your report at ..."). Defaults to
# localhost for development; MUST be set to the real public URL in
# any real deployment, or email links will point at localhost and be
# broken for recipients.
APP_BASE_URL=http://localhost:5000
